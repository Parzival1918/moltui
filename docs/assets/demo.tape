Output docs/assets/demo.gif

Set Shell "bash"
Set FontSize 14
Set Width 1150
Set Height 700
Set Padding 6
Set Framerate 20
Set PlaybackSpeed 1.0
Set TypingSpeed 45ms

Hide
Type "./build/moltui -m half-blocks tests/data/benzene.xyz"
Enter
Sleep 1.2s
Show

Sleep 800ms
Type@120ms "jjjllllll"
Sleep 700ms

Type ":select 1 2"
Enter
Sleep 1.1s

Type ":select 1 2 3"
Enter
Sleep 1.2s

Type "m"
Sleep 400ms

Type "f"
Sleep 900ms
Type "f"
Sleep 500ms

Type ":load tests/data/structures.cif"
Enter
Sleep 1.2s

Type "n"
Sleep 1s

Type ":cell 2 2 2"
Enter
Sleep 1.3s

Type@120ms "lllkk"
Sleep 1s

Type "2"
Sleep 1.2s

Type "?"
Sleep 1.4s
Type "?"
Sleep 500ms

Hide
Type "q"
Sleep 300ms
