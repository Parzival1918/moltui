Output docs/assets/styles_benzene.gif

Set Shell "bash"
Set FontSize 14
Set Width 1150
Set Height 700
Set Padding 6
Set Framerate 20
Set TypingSpeed 45ms

Hide
Type "./build/moltui -m half-blocks --rotate 4 3 tests/data/benzene.xyz"
Enter
Sleep 1s
Show

Sleep 1.2s
Type@140ms "ll"
Sleep 500ms

Type "s"
Sleep 1.4s
Type@140ms "ll"
Sleep 500ms

Type "s"
Sleep 1.4s
Type@140ms "ll"
Sleep 500ms

Type "s"
Sleep 1.4s
Type@140ms "ll"
Sleep 500ms

Type "s"
Sleep 1s

Hide
Type "q"
Sleep 300ms
